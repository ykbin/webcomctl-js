{
  "name": "webcomctl-js",
  "version": "0.0.6",
  "description": "Common controls library for the Web",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./webpack.config.mjs":"./webpack.config.mjs",
    "./loader/cmake-loader": "./src/loader/CMakeLoader.mjs",
    "./loader/module-loader": "./src/loader/ModuleLoader.mjs",
    "./loader/uic-static-loader": "./src/loader/UICStaticLoader.mjs",
    "./document/*": "./dist/document/*.mjs",
    "./control/*": "./dist/control/*.mjs"
  },
  "scripts": {
    "build:base:dbg": "webpack --config webpack.config.mjs --mode development",
    "build:base:rls": "webpack --config webpack.config.mjs --mode production",

    "build:dbg": "node ./build.mjs",
    "build:rls": "node ./build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yacubin/webcomctl-js.git"
  },
  "keywords": [
    "web",
    "node"
  ],
  "author": "Yurii Yakubin",
  "bugs": {
    "url": "https://github.com/yacubin/webcomctl-js/issues"
  },
  "homepage": "https://github.com/yacubin/webcomctl-js#readme",
  "dependencies": {
    "webnetq-js": "github:yacubin/webnetq-js"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "raw-loader": "^4.0.2",
    "svgo": "^3.3.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
